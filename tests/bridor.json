 "steps": [
  {"n":1,"text":"About twelve fixed sensors per proofer report temperature and humidity to the Hypertronic concentrator."},
  {"n":2,"text":"The concentrator publishes readings to AWS IoT Core over MQTT with TLS."},
  {"n":3,"text":"An IoT rule stores every reading in Amazon Timestream."},
  {"n":4,"text":"The Sentinelle API reads the time series for dashboards and alerts."},
  {"n":5,"text":"Operators follow proofer conditions in the Sentinelle web app and adjust settings manually."}
 ]
